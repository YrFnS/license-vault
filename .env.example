# =============================================
# License Vault — Environment Variables
# =============================================

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# App URL (used in emails and API callbacks)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated additional origins for trusted reverse proxies/domains
ALLOWED_ORIGINS=

# Distributed API rate limiting (recommended in production)
# Create an Upstash Redis database and copy its REST credentials.
# When omitted, development uses a bounded per-instance fallback limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP Configuration (leave empty for dev-mode console logging)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=License Vault <noreply@yourdomain.com>
SMTP_FROM_EMAIL=noreply@yourdomain.com

# AI / OpenRouter (for AI chat assistant)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_DOMAIN=openrouter.ai
AI_MAX_COMPLETION_TOKENS=900

# Team invitation signing (generate with: openssl rand -base64 32)
# NEXTAUTH_SECRET is used as a compatibility fallback when this is empty.
TEAM_INVITATION_SECRET=

# External integration credential encryption (generate with: openssl rand -base64 32)
# WEBHOOK_SECRET_ENCRYPTION_KEY or NEXTAUTH_SECRET is used as a fallback.
INTEGRATION_CONFIG_ENCRYPTION_KEY=

# Webhook signing-secret encryption (generate with: openssl rand -base64 32)
# NEXTAUTH_SECRET is used as a compatibility fallback when this is empty.
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Cron Secret (for scheduled tasks — generate with: openssl rand -hex 32)
CRON_SECRET=change-this-to-a-random-secret

# Development
DEV_PORT=3000
# Explicitly opt in before using POST /api/notifications/seed locally
ALLOW_DEMO_NOTIFICATION_SEED=false
